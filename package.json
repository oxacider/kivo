{
  "name": "nextjs_tailwind_shadcn_ts",
  "version": "0.2.1",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000 2>&1 | tee dev.log",
    "build": "next build && cp -r .next/static .next/standalone/.next/ && cp -r public .next/standalone/",
    "build:android": "node -e \"if(!process.env.CAPACITOR_SERVER_URL){console.error('ERROR: CAPACITOR_SERVER_URL is required. Usage: CAPACITOR_SERVER_URL=https://your-server.com bun run build:android');process.exit(1)}\" && next build && mkdir -p out && cp public/logo.png out/ && npx cap sync android",
    "start": "NODE_ENV=production bun .next/standalone/server.js 2>&1 | tee server.log",
    "lint": "eslint .",
    "cap:sync": "npx cap sync",
    "cap:open:android": "npx cap open android",
    "cap:add:android": "npx cap add android",
    "db:push": "prisma db push --accept-data-loss",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset"
  },
